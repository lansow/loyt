# مسیر کتابخانهٔ رسانه روی میزبان؛ داخل کانتینر در /media دیده می‌شود.
MEDIA_HOST_PATH=./media

# دیتابیس، YAMLهای ساخته‌شده، فریم‌ها و قطعه‌های HLS.
APP_DATA_PATH=./data

# در صورت نیاز، کش HLS را از پایگاه داده روی دیسک جدا قرار دهید.
HLS_DATA_PATH=./data/hls

# پورت وب روی میزبان
WEB_PORT=8080

# شناسه کاربری میزبان که اجازه خواندن رسانه و نوشتن در data را دارد.
PUID=1000
PGID=1000

# هر دو مقدار را پیش از اجرا در فایل محلی .env عوض کنید.
ADMIN_PASSWORD=replace-this-with-a-long-password
SESSION_SECRET=replace-this-with-at-least-32-random-characters

# در صورت فعال بودن HTTPS روی reverse proxy به 1 تغییر دهید.
COOKIE_SECURE=0
