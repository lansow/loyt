# Host media library directory, mounted read-only at /media in the containers.
MEDIA_HOST_PATH=./media

# Database, generated YAML manifests, preview frames, and HLS segments.
APP_DATA_PATH=./data

# Optionally keep the HLS cache on a separate disk from the application data.
HLS_DATA_PATH=./data/hls

# Host port for the web interface.
WEB_PORT=8080

# Host user and group IDs with read access to media and write access to data.
PUID=1000
PGID=1000

# Replace both values in your local .env file before starting the services.
ADMIN_PASSWORD=replace-this-with-a-long-password
SESSION_SECRET=replace-this-with-at-least-32-random-characters

# Set to 1 when HTTPS is provided by a reverse proxy.
COOKIE_SECURE=0
